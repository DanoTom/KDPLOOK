{
  "name": "kdplook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Amazon KDP market-research console running on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create kdplook",
    "db:migrate": "wrangler d1 migrations apply kdplook --remote",
    "db:migrate:local": "wrangler d1 migrations apply kdplook --local",
    "cf-typegen": "wrangler types",
    "test": "esbuild tests/parsers.test.ts --bundle --format=esm --platform=node --outfile=tests/.build.mjs --log-level=error && node tests/.build.mjs"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
