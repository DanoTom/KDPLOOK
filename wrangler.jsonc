{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kdplook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Static SPA (built by Vite into ./dist) served straight from the edge.
  // `run_worker_first` keeps the API routes reaching the Worker instead of
  // being swallowed by the single-page-application fallback.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Points at the "kdplook" D1 database in this Cloudflare account. Recreate it
  // with `npx wrangler d1 create kdplook` and swap the id if it ever changes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kdplook",
      "database_id": "030d4d2a-7088-4d21-9e2d-28086bbff1e0",
      "migrations_dir": "migrations"
    }
  ],

  // Daily BSR snapshot for everything on the watchlist (06:10 UTC).
  "triggers": {
    "crons": ["10 6 * * *"]
  },

  // Lets the Worker import the migration file as a string, so the schema can
  // also be applied from the app's Diagnostics screen.
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],

  "vars": {
    "APP_NAME": "KDPLOOK"
  }
}
